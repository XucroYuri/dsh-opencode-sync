{
  "name": "@xucroyuri/dsh-opencode-sync",
  "version": "0.2.0",
  "description": "Sync OpenCode provider configurations, credentials, and model metadata into DeepSeek Harness.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "src",
    "bin",
    "examples",
    "specs",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "CONTRIBUTING.zh.md",
    "SECURITY.md",
    "SECURITY.zh.md",
    "LICENSE"
  ],
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "opencode",
    "llm",
    "provider",
    "sync",
    "credentials"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/XucroYuri/dsh-opencode-sync.git"
  },
  "bugs": {
    "url": "https://github.com/XucroYuri/dsh-opencode-sync/issues"
  },
  "homepage": "https://github.com/XucroYuri/dsh-opencode-sync#readme",
  "author": "XucroYuri",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "dsh-opencode-sync": "bin/dsh-opencode-sync.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepublishOnly": "node --check src/index.js && for f in bin/*.js; do node --check \"$f\"; done",
    "test": "PYTHONPATH=src python3 -m unittest discover -s tests -p 'test_*.py' -v",
    "check": "node --check src/index.js",
    "pack:check": "npm pack --dry-run"
  },
  "sideEffects": false
}
